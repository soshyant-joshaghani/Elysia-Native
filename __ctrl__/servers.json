{
  "defaults": {
    "user": "ubuntu",
    "port": 22,
    "github_org": "soshyant-joshaghani",
    "remote_projects_root": "~/projects",
    "enabled": true,
    "registry_mirror": "https://docker.arvancloud.ir",
    "npm_registry": "https://registry.npmmirror.com",
    "apt_mirror": "http://mirror.arvancloud.ir/ubuntu",
    "dns_servers": ["178.22.122.100", "185.51.200.2"]
  },
  "servers": [
    {
      "id": "elysia-native",
      "project": "elysia-native",
      "site": "bamdad",
      "host_file": "safe/ar-elysia-native-bamdad-address.txt",
      "key": "safe/ar-elysia-native-bamdad-privatekey.pem",
      "env_file": "safe/ar-elysia-native-bamdad-env.env",
      "git_url": "git@github.com:soshyant-joshaghani/Elysia-Native.git",
      "remote_dir": "~/projects/elysia-native",
      "compose_files": ["compose.yml"],
      "start_cmd": "bash __ctrl__/remote/start-prod.sh",
      "stop_cmd": "bash __ctrl__/remote/stop-prod.sh",
      "status_cmd": "docker compose -f compose.yml ps",
      "iran_setup": true,
      "has_acme": true,
      "acme_path": "./letsencrypt/acme.json",
      "app_images": [
        "elysia-native-backend:prod",
        "elysia-native-frontend:prod"
      ],
      "data_volumes": [
        "elysia-native_db-data"
      ]
    }
  ]
}
